# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAILS=admin@startuparena.local
CRON_SECRET=replace-with-a-random-cron-secret
IP_HASH_SECRET=replace-with-a-random-ip-hash-secret

# Leave DATABASE_URL empty to use embedded PGlite in .data/startup-arena.
# Production example: postgres://postgres:postgres@localhost:5432/startup_arena
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PGLITE_DATA_DIR=.data/startup-arena

# Email. Without these values, local development magic links are shown on screen.
RESEND_API_KEY=
EMAIL_FROM=Startup Arena <hello@example.com>

# Stripe. Without these values, local development uses the mock payment adapter.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Bot protection. Optional locally and required when NODE_ENV is production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Conservative maximum accepted bid for the initial paid pilot, in cents.
MAX_BID_CENTS=25000

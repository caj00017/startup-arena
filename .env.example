# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAILS=admin@startuparena.local
CRON_SECRET=replace-with-a-random-cron-secret
IP_HASH_SECRET=replace-with-a-random-ip-hash-secret

# Leave DATABASE_URL empty to use embedded PGlite in .data/startup-arena.
# Production example: postgres://postgres:postgres@localhost:5432/startup_arena
DATABASE_URL=
PGLITE_DATA_DIR=.data/startup-arena

# Email. Without these values, development magic links are shown on screen.
RESEND_API_KEY=
EMAIL_FROM=Startup Arena <hello@example.com>

# Stripe. Without these values, the application uses the local mock payment adapter.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional bot protection. The server bypasses Turnstile when these are empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
